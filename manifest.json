{
  "manifest_version": 3,
  "name": "CodePusher",
  "version": "0.1.0",
  "description": "Save accepted LeetCode solutions to a GitHub repository.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.com/submissions/detail/*"
      ],
      "js": ["content-leetcode.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
