{
  "manifest_version": 3,
  "name": "CodePusher",
  "version": "0.1.0",
  "description": "Save accepted LeetCode and Codeforces solutions to a GitHub repository.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": ["content-markdown.js", "sync-runner.js", "content-leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://codeforces.com/*"
      ],
      "js": ["content-markdown.js", "sync-runner.js", "content-codeforces.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
